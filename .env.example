DOMAIN=transport.example.com
PUBLIC_URL=https://transport.example.com
APP_BASE_URL=https://transport.example.com
APP_SECRET=
PASSENGER_SIGNUP_VERIFICATION=required
SEED_ADMIN_PHONE=
SEED_ADMIN_PIN=
# Provider credentials are configured separately for each tenant in API settings.
# These values are included in every Eganow payment/payout payload and are not user-editable.
EGANOW_DEFAULT_COUNTRY_CODE=GH0233
EGANOW_DEFAULT_LANGUAGE=en
EGANOW_MOMO_PARTNERS=MTNGH,ATGH,TCELGH
COUNTRY_CODE=+233
TOKEN_TTL_H=168
STAFF_TTL_H=12
# Keep SQLite until you have copied and verified data in PostgreSQL.
DB_BACKEND=sqlite
# Used only when DB_BACKEND=postgres. Keep this secret and require TLS for remote hosts.
DATABASE_URL=
# Optional PostgreSQL schema; defaults to public.
POSTGRES_SCHEMA=public
BACKUP_EVERY_H=6
BACKUP_KEEP=28
# --- v1.5 ops ---
HEALTH_KEY=
ALERT_WEBHOOK=
ALERT_COOLDOWN_MIN=60
BACKUP_PING_URL=
TERMS_VERSION=1
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
